}, {
"journal": "Get inside the top three.",
"advance_on": {"type": "flag", "key": "hooks_top_three"}
}, {
"journal": "Take the top hook. Somebody is up there and it is not you.",
"advance_on": {"type": "flag", "key": "hooks_top"}
