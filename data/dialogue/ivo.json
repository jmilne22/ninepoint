{
 "id": "ivo",
 "nodes": {
  "start": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "ivo_introduced"
      ]
     ],
     "goto": "offer"
    },
    {
     "if": [
      [
       "played_at_least",
       "ivo",
       1
      ]
     ],
     "goto": "offer"
    },
    {
     "goto": "hello"
    }
   ]
  },
  "hello": {
   "text": [
    "I came between deliveries. The bicycle can stay outside while we play.",
    "I've got a pencil for the result. I want to finish the games I start."
   ],
   "goto": "offer",
   "actions": [
    [
     "set_flag",
     "ivo_introduced",
     true
    ]
   ]
  },
  "offer": {
   "text": [
    "Shall we play?"
   ],
   "choices": [
    {
     "text": "Our league fixture.",
     "if": [
      [
       "league_fixture",
       "ivo"
      ]
     ],
     "exit": {
      "type": "start_match",
      "profile": "ivo_9x9",
      "context": "league_ivo"
     }
    },
    {
     "text": "A practice game.",
     "exit": {
      "type": "start_match",
      "profile": "ivo_9x9",
      "context": "practice_ivo",
      "unrated": true,
      "practice": true
     }
    },
    {
     "text": "Later.",
     "exit": {
      "type": "end"
     }
    }
   ]
  },
  "post_match": {
   "branches": [
    {
     "if": [
      [
       "won_last"
      ]
     ],
     "goto": "lost"
    },
    {
     "goto": "won"
    }
   ]
  },
  "won": {
   "text": [
    "That's mine. Let me write the result before I forget.",
    "Thanks for the game."
   ],
   "goto": "reaction_offer"
  },
  "lost": {
   "text": [
    "Your game. I'll write that down.",
    "I'm glad we played it through. Thanks."
   ],
   "goto": "reaction_offer"
  },
  "reaction_offer": {}
 }
}
