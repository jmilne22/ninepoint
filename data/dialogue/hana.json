{
 "id": "hana",
 "nodes": {
  "start": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "exam_finished"
      ],
      [
       "not_flag",
       "hana_said_exam"
      ]
     ],
     "goto": "exam_word"
    },
    {
     "if": [
      [
       "flag",
       "enrolled"
      ]
     ],
     "goto": "at_institute"
    },
    {
     "if": [
      [
       "flag",
       "hana_welcomed"
      ]
     ],
     "goto": "welcome_return"
    },
    {
     "goto": "first"
    }
   ]
  },
  "first": {
   "actions": [
    [
     "set_flag",
     "hana_welcomed",
     true
    ]
   ],
   "text": [
    "Hello again. These are the club's rooms in the community centre. Kesh sent you up? Come in.",
    "Noor wants company for her first Cup. Her table is through the lower west door of the hall."
   ],
   "goto": "welcome_class"
  },
  "wait": {
   "text": [
    "I'll keep the position here. Come back when you're ready."
   ]
  },
  "the_offer": {
   "text": [
    "Marguerite keeps the register at the desk in the hall. Tell her I sent you.",
    "Then look at the league board on the back wall. It shows who you'll play first."
   ]
  },
  "at_institute": {
   "text": [
    "The demonstration board has more classes. The practice desk has positions you can repeat."
   ],
   "goto": "teaching_offer"
  },
  "teaching_offer": {
   "branches": [
    {
     "if": [
      [
       "rank_at_least",
       "8k"
      ],
      [
       "flag",
       "lesson_life_and_death_done"
      ]
     ],
     "goto": "even_offer"
    },
    {
     "if": [
      [
       "flag",
       "lesson_life_and_death_done"
      ]
     ],
     "goto": "handicap_offer"
    },
    {
     "goto": "not_yet_ready"
    }
   ]
  },
  "not_yet_ready": {
   "text": [
    "Finish the classes at the demonstration board first. Then we can play a teaching game."
   ]
  },
  "handicap_offer": {
   "text": [
    "Shall we play? I'll set the board up for a teaching game."
   ],
   "choices": [
    {
     "text": "Please.",
     "exit": {
      "type": "start_match",
      "profile": "hana_teaching",
      "context": "hana_teaching"
     }
    },
    {
     "text": "Not today.",
     "goto": "another_day"
    }
   ]
  },
  "even_offer": {
   "text": [
    "I'd like a game with you. Have you got time?"
   ],
   "choices": [
    {
     "text": "Even, then.",
     "exit": {
      "type": "start_match",
      "profile": "hana_9x9",
      "context": "hana_even"
     }
    },
    {
     "text": "Give me the stones.",
     "exit": {
      "type": "start_match",
      "profile": "hana_teaching",
      "context": "hana_teaching"
     }
    }
   ]
  },
  "another_day": {
   "text": [
    "Of course."
   ]
  },
  "post_match": {
   "branches": [
    {
     "if": [
      [
       "won_last"
      ]
     ],
     "goto": "hana_lost"
    },
    {
     "goto": "hana_won"
    }
   ]
  },
  "hana_lost": {
   "text": [
    "Well played. Thank you for the game.",
    "I'd like another when you've got time."
   ]
  },
  "hana_won": {
   "text": [
    "That's a win for me. Thank you for playing.",
    "I'll put the board away. Come back when you'd like another game."
   ]
  },
  "taught": {
   "portrait": "happy",
   "text": [
    "You can try another class at this board, or take a break."
   ]
  },
  "taught_capture_race": {
   "portrait": "happy",
   "text": [
    "You can return to this position whenever you want to practise."
   ]
  },
  "taught_false_eyes": {
   "text": [
    "Leave that position on the board for a moment. Take another look before you go."
   ]
  },
  "exam_word": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "exam_passed"
      ]
     ],
     "goto": "exam_word_passed"
    },
    {
     "goto": "exam_word_failed"
    }
   ]
  },
  "exam_word_passed": {
   "portrait": "happy",
   "actions": [
    [
     "set_flag",
     "hana_said_exam"
    ]
   ],
   "text": [
    "Congratulations! Marguerite told me you qualified.",
    "Come and sit with us. I'd like to hear how the rounds went."
   ],
   "goto": "at_institute"
  },
  "exam_word_failed": {
   "actions": [
    [
     "set_flag",
     "hana_said_exam"
    ]
   ],
   "text": [
    "I'm sorry the exam didn't go your way.",
    "Come and sit with us for a while. There's room at this table."
   ],
   "goto": "at_institute"
  },
  "welcome_class": {
   "text": [
    "What would you like to understand before meeting the group?"
   ],
   "choices": [
    {
     "text": "How can I tell which groups are safe?",
     "exit": {
      "type": "start_lesson",
      "lesson": "two_eyes"
     }
    },
    {
     "text": "A capture reminder.",
     "exit": {
      "type": "start_puzzle",
      "puzzle": "capture_1"
     }
    },
    {
     "text": "I know that already. Where do I join?",
     "goto": "skip_class"
    },
    {
     "text": "I'd like to meet Noor first.",
     "goto": "meet_noor"
    },
    {
     "text": "I'll come back.",
     "goto": "wait"
    }
   ]
  },
  "skip_class": {
   "actions": [
    [
     "set_flag",
     "institute_class_skipped",
     true
    ],
    [
     "set_flag",
     "institute_class_ready",
     true
    ]
   ],
   "goto": "the_offer"
  },
  "welcome_return": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "institute_class_ready"
      ]
     ],
     "goto": "the_offer"
    },
    {
     "goto": "welcome_class"
    }
   ]
  },
  "taught_two_eyes": {
   "text": [
    "Take your time with the groups in your next game. We can look again whenever you want."
   ],
   "goto": "after_welcome_class"
  },
  "after_welcome_class": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "enrolled"
      ]
     ],
     "goto": "class_return"
    },
    {
     "goto": "the_offer"
    }
   ]
  },
  "class_return": {
   "text": [
    "Noor and the others are in the novice room, through the lower west door of the hall."
   ]
  },
  "meet_noor": {
   "text": [
    "Go through the hall's lower west door. She's keeping a place beside her table.",
    "Come back for the class whenever you want. Marguerite at the hall desk can help you join."
   ]
  }
 }
}
