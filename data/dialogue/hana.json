{
 "id": "hana",
 "nodes": {
  "start": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "exam_finished"
      ],
      [
       "not_flag",
       "hana_said_exam"
      ]
     ],
     "goto": "exam_word"
    },
    {
     "if": [
      [
       "flag",
       "enrolled"
      ]
     ],
     "goto": "at_institute"
    },
    {
     "if": [
      [
       "flag",
       "capture_1_solved"
      ]
     ],
     "goto": "after_puzzle"
    },
    {
     "if": [
      [
       "flag",
       "hana_offered_puzzle"
      ]
     ],
     "goto": "puzzle_again"
    },
    {
     "goto": "first"
    }
   ]
  },
  "first": {
   "actions": [
    [
     "set_flag",
     "hana_offered_puzzle",
     true
    ]
   ],
   "text": [
    "Hello again. Kesh sent you up? Come in.",
    "Try this position with me. Take as long as you need."
   ],
   "goto": "offer"
  },
  "offer": {
   "choices": [
    {
     "text": "Show me.",
     "exit": {
      "type": "start_puzzle",
      "puzzle": "capture_1"
     }
    },
    {
     "text": "In a moment.",
     "goto": "wait"
    }
   ]
  },
  "wait": {
   "text": [
    "I'll leave the position here for you."
   ]
  },
  "puzzle_again": {
   "text": [
    "The position is still on the small board. Black to play."
   ],
   "choices": [
    {
     "text": "Try it.",
     "exit": {
      "type": "start_puzzle",
      "puzzle": "capture_1"
     }
    },
    {
     "text": "Not now.",
     "goto": "wait"
    }
   ]
  },
  "after_puzzle": {
   "portrait": "happy",
   "text": [
    "Yes, that's the capture. Ready to join us?"
   ],
   "goto": "the_offer"
  },
  "the_offer": {
   "text": [
    "This is the Essenveld Instituut. Marguerite, at the desk in the hall, keeps the register. Tell her I sent you.",
    "They take beginners. You play in the league, and you come here for the classes."
   ]
  },
  "at_institute": {
   "text": [
    "Use the demonstration board for a class. There are practice positions on the desk, too."
   ],
   "goto": "teaching_offer"
  },
  "teaching_offer": {
   "branches": [
    {
     "if": [
      [
       "rank_at_least",
       "8k"
      ],
      [
       "flag",
       "lesson_life_and_death_done"
      ]
     ],
     "goto": "even_offer"
    },
    {
     "if": [
      [
       "flag",
       "lesson_life_and_death_done"
      ]
     ],
     "goto": "handicap_offer"
    },
    {
     "goto": "not_yet_ready"
    }
   ]
  },
  "not_yet_ready": {
   "text": [
    "Finish the classes at the demonstration board first. Then we can play a teaching game."
   ]
  },
  "handicap_offer": {
   "text": [
    "Shall we play? I'll set the board up for a teaching game."
   ],
   "choices": [
    {
     "text": "Please.",
     "exit": {
      "type": "start_match",
      "profile": "hana_teaching",
      "context": "hana_teaching"
     }
    },
    {
     "text": "Not today.",
     "goto": "another_day"
    }
   ]
  },
  "even_offer": {
   "text": [
    "I'd like a game with you. Have you got time?"
   ],
   "choices": [
    {
     "text": "Even, then.",
     "exit": {
      "type": "start_match",
      "profile": "hana_9x9",
      "context": "hana_even"
     }
    },
    {
     "text": "Give me the stones.",
     "exit": {
      "type": "start_match",
      "profile": "hana_teaching",
      "context": "hana_teaching"
     }
    }
   ]
  },
  "another_day": {
   "text": [
    "Of course."
   ]
  },
  "post_match": {
   "branches": [
    {
     "if": [
      [
       "won_last"
      ]
     ],
     "goto": "hana_lost"
    },
    {
     "goto": "hana_won"
    }
   ]
  },
  "hana_lost": {
   "text": [
    "Well played. Thank you for the game.",
    "I'd like another when you've got time."
   ]
  },
  "hana_won": {
   "text": [
    "That's a win for me. Thank you for playing.",
    "I'll put the board away. Come back when you'd like another game."
   ]
  },
  "taught": {
   "portrait": "happy",
   "text": [
    "Would you like to try another position, or take a break?"
   ]
  },
  "taught_capture_race": {
   "portrait": "happy",
   "text": [
    "You can return to this position whenever you want to practise."
   ]
  },
  "taught_false_eyes": {
   "text": [
    "Leave that position on the board for a moment. Take another look before you go."
   ]
  },
  "exam_word": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "exam_passed"
      ]
     ],
     "goto": "exam_word_passed"
    },
    {
     "goto": "exam_word_failed"
    }
   ]
  },
  "exam_word_passed": {
   "portrait": "happy",
   "actions": [
    [
     "set_flag",
     "hana_said_exam"
    ]
   ],
   "text": [
    "Congratulations! Marguerite told me you qualified.",
    "Come and sit with us. I'd like to hear how the rounds went."
   ],
   "goto": "at_institute"
  },
  "exam_word_failed": {
   "actions": [
    [
     "set_flag",
     "hana_said_exam"
    ]
   ],
   "text": [
    "I'm sorry the exam didn't go your way.",
    "Come and sit with us for a while. There's room at this table."
   ],
   "goto": "at_institute"
  }
 }
}
