{
 "id": "marguerite",
 "nodes": {
  "start": {
   "branches": [
    {
     "if": [
      [
       "on_map",
       "bondszaal"
      ]
     ],
     "goto": "bondszaal_desk"
    },
    {
     "if": [
      [
       "flag",
       "enrolled"
      ],
      [
       "flag",
       "read_league_board"
      ],
      [
       "league_position_at_most",
       4
      ],
      [
       "not_flag",
       "told_exam_eligible"
      ]
     ],
     "goto": "exam_eligible"
    },
    {
     "if": [
      [
       "flag",
       "enrolled"
      ],
      [
       "ranked"
      ],
      [
       "rank_at_most",
       "15k"
      ],
      [
       "not_flag",
       "told_cup_eligible"
      ]
     ],
     "goto": "cup_eligible"
    },
    {
     "if": [
      [
       "flag",
       "enrolled"
      ],
      [
       "rank_at_least",
       "14k"
      ],
      [
       "not_flag",
       "told_cup_outgrown"
      ],
      [
       "not_flag",
       "cup_finished"
      ]
     ],
     "goto": "cup_outgrown"
    },
    {
     "if": [
      [
       "flag",
       "enrolled"
      ]
     ],
     "goto": "enrolled_chat"
    },
    {
     "if": [
      [
       "flag",
       "invited_to_institute"
      ]
     ],
     "goto": "enrol"
    },
    {
     "goto": "who_are_you"
    }
   ]
  },
  "who_are_you": {
   "text": [
    "The register is for students. Hana sends me hers, and you are not one of them yet."
   ]
  },
  "enrol": {
   "text": [
    "Hana sent you. Everybody goes in at the bottom of the lower league."
   ],
   "goto": "enrol_confirm"
  },
  "enrol_confirm": {
   "text": [
    "Sign here. Then read the board behind me."
   ],
   "choices": [
    {
     "text": "Sign.",
     "actions": [
      [
       "set_flag",
       "enrolled",
       true
      ],
      [
       "give",
       "institute_card",
       "Essenveld Instituut card"
      ],
      [
       "toast",
       "Enrolled at the Essenveld Instituut."
      ]
     ],
     "goto": "enrolled_explain"
    },
    {
     "text": "Give me a moment.",
     "goto": "wait"
    }
   ]
  },
  "wait": {
   "text": [
    "The desk will still be here."
   ]
  },
  "enrolled_explain": {
   "text": [
    "The board is the lower league: your record and nothing else. The study hall is west, the classroom east.",
    "The top four of the league sit the qualifying exam at the Bondszaal. That is the entire system."
   ]
  },
  "enrolled_chat": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "read_league_board"
      ],
      [
       "not_flag",
       "marguerite_match_done"
      ]
     ],
     "goto": "league_offer"
    },
    {
     "goto": "enrolled_repeat"
    }
   ]
  },
  "enrolled_repeat": {
   "text": [
    "The board is behind me. Your position is on it. No, I won't tell you whether it's good."
   ]
  },
  "cup_eligible": {
   "actions": [
    [
     "set_flag",
     "told_cup_eligible"
    ]
   ],
   "text": [
    "One thing. You have a rank, so you're eligible for the Beginner Cup: fifteen kyu and below, at the Bondszaal.",
    "The southbound tram. Enter at the desk there. People wait until they feel readier. They never do."
   ],
   "goto": "enrolled_chat"
  },
  "cup_outgrown": {
   "actions": [
    [
     "set_flag",
     "told_cup_outgrown"
    ]
   ],
   "text": [
    "You're past fifteen kyu, so the Beginner Cup is closed to you. The open section is not.",
    "Thirteen lines, handicap by the gap, and the club and the Instituut in one draw. The Bondszaal desk."
   ],
   "goto": "enrolled_chat"
  },
  "exam_eligible": {
   "actions": [
    [
     "set_flag",
     "told_exam_eligible"
    ]
   ],
   "text": [
    "You're in the top four of the lower league, so you sit the qualifying exam. The Bondszaal, when you're ready.",
    "It's a position on a board and it moves. Don't wait long."
   ],
   "goto": "enrolled_chat"
  },
  "league_offer": {
   "text": [
    "You've seen my name on the board. Yes, I play. Slow, orthodox, and I don't lose to beginners."
   ],
   "choices": [
    {
     "text": "The game.",
     "exit": {
      "type": "start_match",
      "profile": "marguerite_9x9",
      "context": "league_marguerite",
      "intro": "League fixture. Sable, one dan."
     }
    },
    {
     "text": "Not today.",
     "goto": "league_later"
    }
   ]
  },
  "league_later": {
   "text": [
    "The offer doesn't expire. I'm always at this desk."
   ]
  },
  "post_match": {
   "branches": [
    {
     "if": [
      [
       "won_last"
      ]
     ],
     "goto": "league_beaten"
    },
    {
     "goto": "league_won"
    }
   ]
  },
  "league_beaten": {
   "text": [
    "Well. That goes on the board, and I have to look at it every day.",
    "Don't tell me it was luck. I dislike false modesty more than I dislike losing."
   ]
  },
  "league_won": {
   "text": [
    "You played the top left properly. Nobody does. The rest we won't discuss."
   ]
  },
  "bondszaal_desk": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "enrolled"
      ]
     ],
     "goto": "which_desk"
    },
    {
     "goto": "cup_desk"
    }
   ]
  },
  "which_desk": {
   "text": [
    "Two events, one desk. Which?"
   ],
   "choices": [
    {
     "text": "The exam.",
     "goto": "exam_desk"
    },
    {
     "text": "The Cup.",
     "goto": "cup_desk"
    }
   ]
  },
  "cup_desk": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "cup_finished"
      ]
     ],
     "goto": "cup_over"
    },
    {
     "if": [
      [
       "flag",
       "cup_started"
      ]
     ],
     "goto": "cup_play"
    },
    {
     "if": [
      [
       "flag",
       "cup_entered"
      ]
     ],
     "goto": "cup_ready"
    },
    {
     "if": [
      [
       "ranked"
      ],
      [
       "rank_at_most",
       "15k"
      ],
      [
       "rated_wins_at_least",
       3
      ]
     ],
     "goto": "cup_choose"
    },
    {
     "if": [
      [
       "ranked"
      ],
      [
       "rank_at_most",
       "15k"
      ]
     ],
     "goto": "cup_enter"
    },
    {
     "if": [
      [
       "ranked"
      ]
     ],
     "goto": "cup_enter_open"
    },
    {
     "goto": "cup_refuse"
    }
   ]
  },
  "cup_refuse": {
   "text": [
    "This is the federation. I need a rank on a card before I can put a name in a draw. Get one and come back."
   ]
  },
  "cup_enter": {
   "text": [
    "The Beginner Cup. Fifteen kyu and below, four rounds, no handicap. You're eligible."
   ],
   "choices": [
    {
     "text": "Enter me.",
     "goto": "cup_entered_confirm"
    },
    {
     "text": "I'll think about it.",
     "goto": "cup_think"
    }
   ]
  },
  "cup_entered_confirm": {
   "actions": [
    [
     "set_flag",
     "cup_entered"
    ],
    [
     "set_flag",
     "cup_section",
     "beginners"
    ],
    [
     "quest_start",
     "beginner_cup"
    ],
    [
     "toast",
     "Entered: the Steenbeek Beginner Cup."
    ]
   ],
   "text": [
    "Entered. Your name goes on the board behind me. Read the draw, and tell me when you're ready to play."
   ]
  },
  "cup_think": {
   "text": [
    "Then think somewhere else. There's no queue. I'd still rather you did."
   ]
  },
  "cup_ready": {
   "text": [
    "You're entered. Ready to play? Once it starts, it runs."
   ],
   "choices": [
    {
     "text": "Ready.",
     "actions": [
      [
       "set_flag",
       "cup_started"
      ],
      [
       "toast",
       "The Cup begins."
      ]
     ],
     "goto": "cup_play"
    },
    {
     "text": "Not yet.",
     "goto": "cup_wait"
    }
   ]
  },
  "cup_wait": {
   "text": [
    "Go and get better in the meantime. That's the only advice the federation gives."
   ]
  },
  "cup_play": {
   "text": [
    "Your board is ready. The draw is on the wall if you want to look first."
   ],
   "choices": [
    {
     "text": "Play the round.",
     "exit": {
      "type": "cup_round"
     }
    },
    {
     "text": "Not yet.",
     "goto": "cup_not_yet"
    }
   ]
  },
  "cup_not_yet": {
   "text": [
    "Then you're holding up a room of people. Briefly."
   ]
  },
  "cup_over": {
   "text": [
    "The Cup is finished, and the result is on the board. That's what a result is."
   ]
  },
  "cup_choose": {
   "text": [
    "Two sections. The beginners' is yours by right. You've also won three rated games, so you may play up.",
    "The open section: no ceiling, thirteen lines, handicap by the gap. Four people who will beat you."
   ],
   "choices": [
    {
     "text": "The beginners' section.",
     "goto": "cup_entered_confirm"
    },
    {
     "text": "The open section.",
     "goto": "cup_entered_open"
    },
    {
     "text": "I'll think about it.",
     "goto": "cup_think"
    }
   ]
  },
  "cup_enter_open": {
   "text": [
    "You're past fifteen kyu, so the beginners' section is closed. The open section: no ceiling, thirteen lines."
   ],
   "choices": [
    {
     "text": "Enter me.",
     "goto": "cup_entered_open"
    },
    {
     "text": "I'll think about it.",
     "goto": "cup_think"
    }
   ]
  },
  "cup_entered_open": {
   "actions": [
    [
     "set_flag",
     "cup_entered"
    ],
    [
     "set_flag",
     "cup_section",
     "open"
    ],
    [
     "quest_start",
     "beginner_cup"
    ],
    [
     "toast",
     "Entered: the Steenbeek Cup, open section."
    ]
   ],
   "text": [
    "Entered, open section. Your name goes under people who won't be pleased to see it. Tell me when you're ready."
   ]
  },
  "exam_desk": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "exam_finished"
      ]
     ],
     "goto": "exam_over"
    },
    {
     "if": [
      [
       "flag",
       "exam_started"
      ],
      [
       "flag",
       "exam_paper_done"
      ]
     ],
     "goto": "exam_play"
    },
    {
     "if": [
      [
       "flag",
       "exam_started"
      ]
     ],
     "goto": "exam_paper_offer"
    },
    {
     "if": [
      [
       "flag",
       "exam_entered"
      ]
     ],
     "goto": "exam_ready"
    },
    {
     "if": [
      [
       "league_position_at_most",
       4
      ]
     ],
     "goto": "exam_enter"
    },
    {
     "goto": "exam_refuse"
    }
   ]
  },
  "exam_refuse": {
   "text": [
    "The exam is for the top four of the lower league. You're not in it. The study hall is open. Change the number."
   ]
  },
  "exam_enter": {
   "text": [
    "The qualifying exam. Four sit it, three rounds, no handicap, top two pass.",
    "There's a paper first. Two positions, set by me. It decides nothing. It tells me what you can see."
   ],
   "choices": [
    {
     "text": "Put my name down.",
     "goto": "exam_entered_confirm"
    },
    {
     "text": "Let me think.",
     "goto": "exam_think"
    }
   ]
  },
  "exam_entered_confirm": {
   "actions": [
    [
     "set_flag",
     "exam_entered"
    ],
    [
     "quest_start",
     "qualifying_exam"
    ],
    [
     "toast",
     "Entered: the qualifying exam."
    ]
   ],
   "text": [
    "Down. The list goes up with whoever is in the four on the day, not whoever was. Tell me when you're ready."
   ]
  },
  "exam_think": {
   "text": [
    "You're in the four. Thinking about it doesn't keep you there."
   ]
  },
  "exam_ready": {
   "text": [
    "You're entered. Ready to sit it? The field is fixed the moment we start."
   ],
   "choices": [
    {
     "text": "Ready.",
     "actions": [
      [
       "set_flag",
       "exam_started"
      ],
      [
       "toast",
       "The exam begins."
      ]
     ],
     "goto": "exam_paper_offer"
    },
    {
     "text": "Not yet.",
     "goto": "exam_wait"
    }
   ]
  },
  "exam_wait": {
   "text": [
    "Play league games. It's the same board you're being judged on."
   ]
  },
  "exam_paper_offer": {
   "text": [
    "Paper first. Two positions, no hints."
   ],
   "choices": [
    {
     "text": "Sit it.",
     "exit": {
      "type": "exam_paper"
     }
    },
    {
     "text": "Not yet.",
     "goto": "exam_paper_later"
    }
   ]
  },
  "exam_paper_later": {
   "text": [
    "The rounds don't start until it's done. That's a running order, not a threat."
   ]
  },
  "exam_play": {
   "text": [
    "Your board is ready. The list is on the wall."
   ],
   "choices": [
    {
     "text": "Play the round.",
     "exit": {
      "type": "exam_round"
     }
    },
    {
     "text": "Not yet.",
     "goto": "exam_not_yet"
    }
   ]
  },
  "exam_not_yet": {
   "text": [
    "Somebody is sitting at a board waiting for you."
   ]
  },
  "exam_over": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "exam_passed"
      ]
     ],
     "goto": "exam_passed"
    },
    {
     "goto": "exam_failed"
    }
   ]
  },
  "exam_passed": {
   "actions": [
    [
     "give",
     "instituut_certificate",
     "Instituut certificate"
    ]
   ],
   "text": [
    "You qualified. Here: a card with a date on it. It doesn't make you stronger.",
    "It says you were measured, in front of witnesses, and you held."
   ]
  },
  "exam_failed": {
   "text": [
    "You didn't qualify. The result is on the wall.",
    "It's a verdict on three games, not on you. There's another term."
   ]
  }
 }
}
