{
 "id": "marguerite",
 "nodes": {
  "start": {
   "branches": [
    {
     "if": [
      [
       "on_map",
       "bondszaal"
      ]
     ],
     "goto": "bondszaal_desk"
    },
    {
     "if": [
      [
       "flag",
       "enrolled"
      ],
      [
       "flag",
       "read_league_board"
      ],
      [
       "league_position_at_most",
       4
      ],
      [
       "not_flag",
       "told_exam_eligible"
      ],
      [
       "flag",
       "cup_finished"
      ]
     ],
     "goto": "exam_eligible"
    },
    {
     "if": [
      [
       "flag",
       "enrolled"
      ],
      [
       "ranked"
      ],
      [
       "rank_at_most",
       "15k"
      ],
      [
       "not_flag",
       "told_cup_eligible"
      ],
      [
       "flag",
       "novice_league_completed"
      ]
     ],
     "goto": "cup_eligible"
    },
    {
     "if": [
      [
       "flag",
       "enrolled"
      ],
      [
       "rank_at_least",
       "14k"
      ],
      [
       "not_flag",
       "told_cup_outgrown"
      ],
      [
       "not_flag",
       "cup_finished"
      ]
     ],
     "goto": "cup_outgrown"
    },
    {
     "if": [
      [
       "flag",
       "enrolled"
      ]
     ],
     "goto": "enrolled_chat"
    },
    {
     "if": [
      [
       "flag",
       "invited_to_institute"
      ]
     ],
     "goto": "enrol"
    },
    {
     "goto": "who_are_you"
    }
   ]
  },
  "who_are_you": {
   "text": [
    "Welcome. Speak to Hana in the classroom, through the east door. She'll help you get started."
   ]
  },
  "enrol": {
   "text": [
    "Hana sent you? I can register you for the Novice League."
   ],
   "goto": "enrol_confirm"
  },
  "enrol_confirm": {
   "text": [
    "Sign here. Then read the league board on the back wall."
   ],
   "choices": [
    {
     "text": "Sign.",
     "actions": [
      [
       "set_flag",
       "enrolled",
       true
      ],
      [
       "give",
       "institute_card",
       "Essenveld Instituut card"
      ],
      [
       "toast",
       "Enrolled at the Essenveld Instituut."
      ],
      [
       "league_start",
       "novice"
      ]
     ],
     "goto": "enrolled_explain"
    },
    {
     "text": "Give me a moment.",
     "goto": "wait"
    }
   ]
  },
  "wait": {
   "text": [
    "The desk will still be here."
   ]
  },
  "enrolled_explain": {
   "text": [
    "The novice room is through the lower west door. The classroom is east.",
    "Your five fixtures prepare you for the Cup. Read the league board behind me to find your next opponent."
   ]
  },
  "enrolled_chat": {
   "goto": "league_desk"
  },
  "cup_eligible": {
   "actions": [
    [
     "set_flag",
     "told_cup_eligible"
    ]
   ],
   "text": [
    "You've finished your novice fixtures. The Cup is at the Bondszaal; take the southbound tram.",
    "You can enter whatever your placing here. Register at the desk when you're ready."
   ],
   "goto": "enrolled_chat"
  },
  "cup_outgrown": {
   "actions": [
    [
     "set_flag",
     "told_cup_outgrown"
    ]
   ],
   "text": [
    "You can enter the Cup's open section at the Bondszaal. Take the southbound tram.",
    "The registration desk is beside the entrance."
   ],
   "goto": "enrolled_chat"
  },
  "exam_eligible": {
   "actions": [
    [
     "set_flag",
     "told_exam_eligible"
    ]
   ],
   "text": [
    "You're in the top four. You can enter the qualifying exam at the Bondszaal.",
    "Register there and tell me when you're ready to start."
   ],
   "goto": "enrolled_chat"
  },
  "league_offer": {
   "text": [
    "Would you like a league game? I can leave the register for a while."
   ],
   "choices": [
    {
     "text": "The game.",
     "exit": {
      "type": "start_match",
      "profile": "marguerite_9x9",
      "context": "league_marguerite"
     }
    },
    {
     "text": "Not today.",
     "goto": "league_later"
    }
   ]
  },
  "league_later": {
   "text": [
    "Come back when you're ready."
   ]
  },
  "post_match": {
   "branches": [
    {
     "if": [
      [
       "won_last"
      ]
     ],
     "goto": "league_beaten"
    },
    {
     "goto": "league_won"
    }
   ]
  },
  "league_beaten": {
   "text": [
    "Well played. Thank you for the game."
   ]
  },
  "league_won": {
   "text": [
    "A win for me. Thank you for playing."
   ]
  },
  "bondszaal_desk": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "enrolled"
      ]
     ],
     "goto": "which_desk"
    },
    {
     "goto": "cup_desk"
    }
   ]
  },
  "which_desk": {
   "text": [
    "Are you here for the Cup or the qualifying exam?"
   ],
   "choices": [
    {
     "text": "The exam.",
     "goto": "exam_desk"
    },
    {
     "text": "The Cup.",
     "goto": "cup_desk"
    }
   ]
  },
  "cup_desk": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "cup_finished"
      ]
     ],
     "goto": "cup_over"
    },
    {
     "if": [
      [
       "flag",
       "cup_started"
      ]
     ],
     "goto": "cup_play"
    },
    {
     "if": [
      [
       "flag",
       "cup_entered"
      ]
     ],
     "goto": "cup_ready"
    },
    {
     "if": [
      [
       "ranked"
      ],
      [
       "rank_at_most",
       "15k"
      ],
      [
       "rated_wins_at_least",
       3
      ]
     ],
     "goto": "cup_choose"
    },
    {
     "if": [
      [
       "ranked"
      ],
      [
       "rank_at_most",
       "15k"
      ]
     ],
     "goto": "cup_enter"
    },
    {
     "if": [
      [
       "ranked"
      ]
     ],
     "goto": "cup_enter_open"
    },
    {
     "goto": "cup_refuse"
    }
   ]
  },
  "cup_refuse": {
   "text": [
    "You need a rank to enter. Play Kesh at De Ketel first, then come back to this desk."
   ]
  },
  "cup_enter": {
   "text": [
    "You're eligible for the beginners' section: nine lines, with handicap based on rank.",
    "Shall I enter you?"
   ],
   "choices": [
    {
     "text": "Enter me.",
     "goto": "cup_entered_confirm"
    },
    {
     "text": "I'll think about it.",
     "goto": "cup_think"
    }
   ]
  },
  "cup_entered_confirm": {
   "actions": [
    [
     "set_flag",
     "cup_entered"
    ],
    [
     "set_flag",
     "cup_section",
     "beginners"
    ],
    [
     "quest_start",
     "beginner_cup"
    ],
    [
     "toast",
     "Entered: the Steenbeek Beginner Cup."
    ],
    [
     "cup_rules",
     "beginners"
    ]
   ],
   "text": [
    "You're entered. The draw is at the far end of the hall. Tell me when you're ready."
   ]
  },
  "cup_think": {
   "text": [
    "Take your time. The entry details are on the board."
   ]
  },
  "cup_ready": {
   "text": [
    "Ready to start? We'll play all the rounds in order."
   ],
   "choices": [
    {
     "text": "Ready.",
     "actions": [
      [
       "set_flag",
       "cup_started"
      ],
      [
       "toast",
       "The Cup begins."
      ]
     ],
     "goto": "cup_play"
    },
    {
     "text": "Not yet.",
     "goto": "cup_wait"
    }
   ]
  },
  "cup_wait": {
   "text": [
    "Come back to this desk when you're ready."
   ]
  },
  "cup_play": {
   "text": [
    "Your board is ready. The draw is on the wall if you want to look first."
   ],
   "choices": [
    {
     "text": "Play the round.",
     "exit": {
      "type": "cup_round"
     }
    },
    {
     "text": "Not yet.",
     "goto": "cup_not_yet"
    }
   ]
  },
  "cup_not_yet": {
   "text": [
    "All right. Come back here to begin the next round."
   ]
  },
  "cup_over": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "cup_won"
      ]
     ],
     "goto": "cup_champion"
    },
    {
     "goto": "cup_completed"
    }
   ]
  },
  "cup_choose": {
   "text": [
    "You can enter the beginners' section or play up in the open section.",
    "The open section uses the larger board. Which would you like?"
   ],
   "choices": [
    {
     "text": "The beginners' section.",
     "goto": "cup_entered_confirm"
    },
    {
     "text": "The open section.",
     "goto": "cup_entered_open"
    },
    {
     "text": "I'll think about it.",
     "goto": "cup_think"
    }
   ]
  },
  "cup_enter_open": {
   "text": [
    "You're eligible for the open section. Shall I enter you?"
   ],
   "choices": [
    {
     "text": "Enter me.",
     "goto": "cup_entered_open"
    },
    {
     "text": "I'll think about it.",
     "goto": "cup_think"
    }
   ]
  },
  "cup_entered_open": {
   "actions": [
    [
     "set_flag",
     "cup_entered"
    ],
    [
     "set_flag",
     "cup_section",
     "open"
    ],
    [
     "quest_start",
     "beginner_cup"
    ],
    [
     "toast",
     "Entered: the Steenbeek Cup, open section."
    ],
    [
     "cup_rules",
     "open"
    ]
   ],
   "text": [
    "You're entered in the open section. Tell me when you're ready to start."
   ]
  },
  "exam_desk": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "exam_finished"
      ]
     ],
     "goto": "exam_over"
    },
    {
     "if": [
      [
       "flag",
       "exam_started"
      ],
      [
       "flag",
       "exam_paper_done"
      ]
     ],
     "goto": "exam_play"
    },
    {
     "if": [
      [
       "flag",
       "exam_started"
      ]
     ],
     "goto": "exam_paper_offer"
    },
    {
     "if": [
      [
       "flag",
       "exam_entered"
      ]
     ],
     "goto": "exam_ready"
    },
    {
     "if": [
      [
       "league_position_at_most",
       4
      ]
     ],
     "goto": "exam_enter"
    },
    {
     "goto": "exam_refuse"
    }
   ]
  },
  "exam_refuse": {
   "text": [
    "Finish an Academy League attempt in the top four eligible places. The Instituut board has the details."
   ]
  },
  "exam_enter": {
   "text": [
    "The top two finishers qualify. First, there's a short problem paper; it doesn't affect your result.",
    "Then you play each of the other entrants. The exam board has the details."
   ],
   "choices": [
    {
     "text": "Put my name down.",
     "goto": "exam_entered_confirm"
    },
    {
     "text": "Let me think.",
     "goto": "exam_think"
    }
   ]
  },
  "exam_entered_confirm": {
   "actions": [
    [
     "set_flag",
     "exam_entered"
    ],
    [
     "quest_start",
     "qualifying_exam"
    ],
    [
     "toast",
     "Entered: the qualifying exam."
    ]
   ],
   "text": [
    "You're entered. You must still be in the top four when we start. Tell me when you're ready."
   ]
  },
  "exam_think": {
   "text": [
    "All right. You can check your eligibility on the league board."
   ]
  },
  "exam_ready": {
   "text": [
    "You're entered. Ready to sit it? The field is fixed the moment we start."
   ],
   "choices": [
    {
     "text": "Ready.",
     "actions": [
      [
       "set_flag",
       "exam_started"
      ],
      [
       "toast",
       "The exam begins."
      ]
     ],
     "goto": "exam_paper_offer"
    },
    {
     "text": "Not yet.",
     "goto": "exam_wait"
    }
   ]
  },
  "exam_wait": {
   "text": [
    "Come back here when you're ready to begin."
   ]
  },
  "exam_paper_offer": {
   "text": [
    "First, two practice positions. They do not affect your placing. Ready?"
   ],
   "choices": [
    {
     "text": "Sit it.",
     "exit": {
      "type": "exam_paper"
     }
    },
    {
     "text": "Not yet.",
     "goto": "exam_paper_later"
    }
   ]
  },
  "exam_paper_later": {
   "text": [
    "Finish the paper before starting the rounds. Come back when you're ready."
   ]
  },
  "exam_play": {
   "text": [
    "Your board is ready. The list is on the wall."
   ],
   "choices": [
    {
     "text": "Play the round.",
     "exit": {
      "type": "exam_round"
     }
    },
    {
     "text": "Not yet.",
     "goto": "exam_not_yet"
    }
   ]
  },
  "exam_not_yet": {
   "text": [
    "Come back to this desk to begin your next round."
   ]
  },
  "exam_over": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "exam_passed"
      ]
     ],
     "goto": "exam_passed"
    },
    {
     "goto": "exam_failed"
    }
   ]
  },
  "exam_passed": {
   "actions": [
    [
     "give",
     "instituut_certificate",
     "Instituut certificate"
    ]
   ],
   "text": [
    "Congratulations! You qualified. Here's your certificate.",
    "Your results are on the board. Hana will be pleased to hear."
   ]
  },
  "exam_failed": {
   "text": [
    "You didn't qualify this time. Your results are on the board.",
    "Thank you for playing all your rounds. You're welcome back at the Instituut."
   ]
  },
  "cup_champion": {
   "text": [
    "Congratulations! You won your section. I'll put your name at the top of the results.",
    "Stay for tea if you can. People will want to congratulate you."
   ],
   "goto": "cup_completed"
  },
  "cup_completed": {
   "text": [
    "Four rounds played. Your first Cup is complete; the results are on the board.",
    "Come back to the Instituut if you'd like to try the Academy League. There is no hurry."
   ]
  },
  "league_desk": {
   "text": [
    "Looking for your next game, or another league attempt?"
   ],
   "choices": [
    {
     "text": "The Novice League.",
     "if": [
      [
       "league_can_start",
       "novice"
      ]
     ],
     "goto": "novice_register"
    },
    {
     "text": "The Academy League.",
     "if": [
      [
       "league_can_start",
       "academy"
      ]
     ],
     "goto": "academy_register"
    },
    {
     "text": "Our scheduled fixture.",
     "if": [
      [
       "league_fixture",
       "marguerite"
      ]
     ],
     "goto": "league_offer"
    },
    {
     "text": "A practice game.",
     "exit": {
      "type": "start_match",
      "profile": "marguerite_9x9",
      "context": "practice_marguerite",
      "unrated": true,
      "practice": true
     }
    },
    {
     "text": "Where is my next game?",
     "goto": "league_direction"
    },
    {
     "text": "See you.",
     "exit": {
      "type": "end"
     }
    }
   ]
  },
  "league_direction": {
   "text": [
    "The league board behind me lists your next opponent and the results so far.",
    "Novices use the lower west room. Academy players use the study hall and classroom; Kesh is at De Ketel."
   ]
  },
  "novice_register": {
   "text": [
    "Five fixtures on nine lines. You can play practice games between them.",
    "A finished attempt stays on the board. A new attempt starts everyone at zero."
   ],
   "choices": [
    {
     "text": "Register.",
     "actions": [
      [
       "league_start",
       "novice"
      ]
     ],
     "goto": "novice_registered"
    },
    {
     "text": "Later.",
     "exit": {
      "type": "end"
     }
    }
   ]
  },
  "novice_registered": {
   "text": [
    "You're in. Read the board for your first fixture, then take the lower west door to the novice room."
   ]
  },
  "academy_register": {
   "text": [
    "The Academy League ranges from Kesh at 12k to me at 1d. It is a bigger challenge.",
    "Finish all six fixtures. The top four eligible players can sit the exam, where games are even."
   ],
   "choices": [
    {
     "text": "Register.",
     "actions": [
      [
       "league_start",
       "academy"
      ]
     ],
     "goto": "academy_registered"
    },
    {
     "text": "Later.",
     "exit": {
      "type": "end"
     }
    }
   ]
  },
  "academy_registered": {
   "text": [
    "Your Academy attempt is on the board. It lists the next fixture and the entry ranks used for ties."
   ]
  }
 }
}
