{
 "id": "tomas",
 "nodes": {
  "start": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "lesson_counting_done"
      ]
     ],
     "goto": "after_lesson"
    },
    {
     "if": [
      [
       "flag",
       "knows_the_rules"
      ]
     ],
     "goto": "offer_counting"
    },
    {
     "goto": "first"
    }
   ]
  },
  "first": {
   "text": [
    "Tomás. Welcome to The Kettle. Mind the wet patch; I've just washed the floor."
   ],
   "portrait": "working",
   "choices": [
    {
     "text": "Just saying hello.",
     "goto": "neighbour"
    },
    {
     "text": "Does the Go club meet here?",
     "goto": "club_tables"
    }
   ]
  },
  "offer_counting": {
   "text": [
    "Want a lesson in finishing a game? I'll bring the counting board over."
   ],
   "choices": [
    {
     "text": "Show me.",
     "exit": {
      "type": "start_lesson",
      "lesson": "counting"
     }
    },
    {
     "text": "Another time.",
     "goto": "later"
    },
    {
     "text": "How is the bar doing?",
     "goto": "bar_work"
    }
   ]
  },
  "later": {
   "text": [
    "All right. I need to get these cups washed."
   ]
  },
  "taught": {
   "goto": "after_lesson"
  },
  "after_lesson": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "tomas_match_done"
      ]
     ],
     "goto": "regular"
    },
    {
     "goto": "offer_game"
    }
   ]
  },
  "offer_game": {
   "text": [
    "The table's wiped down. Ready for a game?"
   ],
   "choices": [
    {
     "text": "One game.",
     "exit": {
      "type": "start_match",
      "profile": "tomas_9x9",
      "context": "tomas_club"
     }
    },
    {
     "text": "Not today.",
     "goto": "later"
    },
    {
     "text": "How is the bar doing?",
     "goto": "bar_work"
    }
   ]
  },
  "regular": {
   "branches": [
    {
     "if": [
      [
       "rated_wins_at_least",
       3
      ],
      [
       "not_flag",
       "match_tomas_thirteen_done"
      ]
     ],
     "goto": "offer_thirteen"
    },
    {
     "if": [
      [
       "flag",
       "match_tomas_thirteen_done"
      ]
     ],
     "goto": "thirteen_again"
    },
    {
     "goto": "offer_again"
    }
   ]
  },
  "offer_again": {
   "text": [
    "Another? I'll clear the cups first."
   ],
   "choices": [
    {
     "text": "Again.",
     "exit": {
      "type": "start_match",
      "profile": "tomas_9x9",
      "context": "tomas_club"
     }
    },
    {
     "text": "Not today.",
     "goto": "later"
    },
    {
     "text": "How is the bar doing?",
     "goto": "bar_work"
    }
   ]
  },
  "offer_thirteen": {
   "text": [
    "You've won enough rated games to use the back table. I've put the larger board under the coats.",
    "Shall we play there?"
   ],
   "choices": [
    {
     "text": "Let's play there.",
     "exit": {
      "type": "start_match",
      "profile": "tomas_13x13",
      "context": "tomas_thirteen"
     }
    },
    {
     "text": "Nine is enough.",
     "goto": "offer_again"
    }
   ]
  },
  "thirteen_again": {
   "text": [
    "The back table's free. Want a game?"
   ],
   "choices": [
    {
     "text": "Thirteen, then.",
     "exit": {
      "type": "start_match",
      "profile": "tomas_13x13",
      "context": "tomas_thirteen"
     }
    },
    {
     "text": "Nine today.",
     "goto": "offer_again"
    },
    {
     "text": "Not today.",
     "goto": "later"
    },
    {
     "text": "How is the bar doing?",
     "goto": "bar_work"
    }
   ]
  },
  "post_match": {
   "branches": [
    {
     "if": [
      [
       "won_last"
      ]
     ],
     "goto": "beaten"
    },
    {
     "goto": "won"
    }
   ]
  },
  "beaten": {
   "text": [
    "You won. Well played.",
    "Leave the cups. I'll take them to the counter."
   ]
  },
  "won": {
   "text": [
    "That's a win for me. Thanks for playing.",
    "Give me a moment to clear this table before we start another."
   ]
  },
  "neighbour": {
   "text": [
    "Then hello. You're welcome to sit while I finish this.",
    "If the chair wobbles, swap it with the one by the wall. I keep forgetting which it is."
   ]
  },
  "club_tables": {
   "text": [
    "They use the tables when there's space. Wren volunteers to help beginners; she's by the window.",
    "For classes, the club rents rooms at the community centre. Tram 4 goes there from this street's west end."
   ]
  },
  "bar_work": {
   "portrait": "working",
   "text": [
    "Someone brought all the blue cups back at once. I've nearly run out of shelf.",
    "Could you leave that bit of the table clear? I need somewhere for the clean ones."
   ]
  }
 }
}
