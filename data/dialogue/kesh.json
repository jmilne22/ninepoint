{
 "id": "kesh",
 "nodes": {
  "start": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "enrolled"
      ]
     ],
     "goto": "league_gate"
    },
    {
     "if": [
      [
       "flag",
       "kesh_match_done"
      ]
     ],
     "goto": "regular"
    },
    {
     "if": [
      [
       "flag",
       "wren_match_done"
      ]
     ],
     "goto": "challenge"
    },
    {
     "goto": "cold_open"
    }
   ]
  },
  "cold_open": {
   "portrait": "annoyed",
   "text": [
    "I'm Kesh. Have a practice game with Wren first. I'll play you when you're done."
   ]
  },
  "challenge": {
   "text": [
    "Ready for your first rated game? We'll draw for colours."
   ],
   "goto": "offer"
  },
  "offer": {
   "text": [
    "Shall I set up?"
   ],
   "choices": [
    {
     "text": "Let's play.",
     "actions": [
      [
       "set_flag",
       "kesh_challenge_accepted",
       true
      ]
     ],
     "exit": {
      "type": "start_match",
      "profile": "kesh_first",
      "context": "kesh_first"
     }
    },
    {
     "text": "Give me a minute.",
     "goto": "wait"
    }
   ]
  },
  "wait": {
   "portrait": "annoyed",
   "text": [
    "I'll keep the table."
   ]
  },
  "regular": {
   "text": [
    "Back. Good."
   ],
   "goto": "rematch_offer"
  },
  "post_match": {
   "branches": [
    {
     "if": [
      [
       "unranked"
      ]
     ],
     "goto": "first_rating"
    },
    {
     "goto": "result"
    }
   ]
  },
  "first_rating": {
   "actions": [
    [
     "rank",
     "22k"
    ],
    [
     "set_flag",
     "ranked_by_club",
     true
    ],
    [
     "set_flag",
     "invited_to_institute",
     true
    ],
    [
     "quest_start",
     "enrolment"
    ],
    [
     "toast",
     "The club has you at 22 kyu."
    ]
   ],
   "text": [
    "You're on the club register now. Here's your rank card.",
    "Hana teaches at the Instituut. Take the northbound tram from the west end of this street."
   ],
   "goto": "result"
  },
  "result": {
   "branches": [
    {
     "if": [
      [
       "won_last"
      ],
      [
       "flag_at_least",
       "record_kesh_win",
       2
      ]
     ],
     "goto": "beaten_twice"
    },
    {
     "if": [
      [
       "won_last"
      ]
     ],
     "goto": "beaten"
    },
    {
     "goto": "won"
    }
   ]
  },
  "beaten": {
   "portrait": "annoyed",
   "actions": [
    [
     "set_flag",
     "kesh_lost_once",
     true
    ]
   ],
   "text": [
    "You won. Well played.",
    "I want another game when you've got time."
   ],
   "goto": "after_result"
  },
  "beaten_twice": {
   "portrait": "annoyed",
   "text": [
    "You've beaten me again. Right. I'm keeping this board out."
   ],
   "goto": "after_result"
  },
  "won": {
   "actions": [
    [
     "set_flag",
     "kesh_won_once",
     true
    ]
   ],
   "text": [
    "That's a win for me. Thanks for playing.",
    "Come back for another."
   ],
   "goto": "after_result"
  },
  "after_result": {
   "branches": [
    {
     "if": [
      [
       "not_flag",
       "lesson_escape_done"
      ]
     ],
     "goto": "offer_escape"
    },
    {
     "if": [
      [
       "not_flag",
       "lesson_connection_done"
      ]
     ],
     "goto": "offer_connection"
    },
    {
     "goto": "rematch_offer"
    }
   ]
  },
  "offer_escape": {
   "text": [
    "Want to practise getting a group out of trouble? I've set up a position."
   ],
   "choices": [
    {
     "text": "Show me.",
     "exit": {
      "type": "start_lesson",
      "lesson": "escape"
     }
    },
    {
     "text": "Not now.",
     "goto": "rematch_offer"
    }
   ]
  },
  "offer_connection": {
   "text": [
    "I've got a connection problem ready. Want to try it?"
   ],
   "choices": [
    {
     "text": "Show me.",
     "exit": {
      "type": "start_lesson",
      "lesson": "connection"
     }
    },
    {
     "text": "Not now.",
     "goto": "rematch_offer"
    }
   ]
  },
  "taught_escape": {
   "text": [
    "Try that position again whenever you like. I'll keep it with the practice boards."
   ],
   "goto": "rematch_offer"
  },
  "taught_connection": {
   "text": [
    "Got it. Ready to play, or taking a break?"
   ],
   "goto": "rematch_offer"
  },
  "rematch_offer": {
   "text": [
    "Another game? I'm ready."
   ],
   "choices": [
    {
     "text": "Again.",
     "exit": {
      "type": "start_match",
      "profile": "kesh_9x9",
      "context": "kesh_rematch"
     }
    },
    {
     "text": "Thirteen.",
     "if": [
      [
       "rated_wins_at_least",
       3
      ]
     ],
     "exit": {
      "type": "start_match",
      "profile": "kesh_13x13",
      "context": "kesh_thirteen"
     }
    },
    {
     "text": "Later.",
     "goto": "later"
    }
   ]
  },
  "later": {
   "text": [
    "Later, then. I'll be here."
   ]
  },
  "league_gate": {
   "branches": [
    {
     "if": [
      [
       "rated_wins_at_least",
       3
      ],
      [
       "not_flag",
       "match_kesh_thirteen_done"
      ]
     ],
     "goto": "thirteen_word"
    },
    {
     "goto": "league_offer"
    }
   ]
  },
  "thirteen_word": {
   "portrait": "annoyed",
   "text": [
    "Tomás has put the larger board out under the coats at the back.",
    "I'd like to play you there."
   ],
   "goto": "league_offer"
  },
  "league_offer": {
   "text": [
    "League game? I want to move up the table."
   ],
   "choices": [
    {
     "text": "It counts. Go on.",
     "exit": {
      "type": "start_match",
      "profile": "kesh_9x9",
      "context": "league_kesh"
     }
    },
    {
     "text": "Thirteen.",
     "if": [
      [
       "rated_wins_at_least",
       3
      ]
     ],
     "exit": {
      "type": "start_match",
      "profile": "kesh_13x13",
      "context": "kesh_thirteen"
     }
    },
    {
     "text": "Later.",
     "goto": "later"
    }
   ]
  }
 }
}
