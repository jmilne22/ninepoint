{
 "id": "noor",
 "nodes": {
  "start": {
   "branches": [
    {
     "if": [
      [
       "flag",
       "cup_finished"
      ],
      [
       "not_flag",
       "noor_cup_return_seen"
      ]
     ],
     "goto": "cup_return"
    },
    {
     "if": [
      [
       "flag",
       "novice_league_completed"
      ],
      [
       "not_flag",
       "noor_league_return_seen"
      ],
      [
       "not_flag",
       "cup_finished"
      ]
     ],
     "goto": "league_return"
    },
    {
     "if": [
      [
       "flag",
       "noor_introduced"
      ]
     ],
     "goto": "offer"
    },
    {
     "if": [
      [
       "played_at_least",
       "noor",
       1
      ]
     ],
     "goto": "offer"
    },
    {
     "goto": "hello"
    }
   ]
  },
  "hello": {
   "text": [
    "I've kept this postcard dry all morning. Here, there's room beside my table.",
    "I'm new too. I'd like someone to go to the local Cup with. We could practise together first."
   ],
   "goto": "newcomer_choice",
   "actions": [
    [
     "set_flag",
     "noor_introduced",
     true
    ]
   ]
  },
  "offer": {
   "text": [
    "Shall we play?"
   ],
   "choices": [
    {
     "text": "Our league fixture.",
     "if": [
      [
       "league_fixture",
       "noor"
      ]
     ],
     "exit": {
      "type": "start_match",
      "profile": "noor_9x9",
      "context": "league_noor"
     }
    },
    {
     "text": "A practice game.",
     "exit": {
      "type": "start_match",
      "profile": "noor_9x9",
      "context": "practice_noor",
      "unrated": true,
      "practice": true
     }
    },
    {
     "text": "Later.",
     "exit": {
      "type": "end"
     }
    },
    {
     "text": "What is on the postcard?",
     "goto": "postcard"
    }
   ]
  },
  "post_match": {
   "branches": [
    {
     "if": [
      [
       "won_last"
      ]
     ],
     "goto": "lost"
    },
    {
     "goto": "won"
    }
   ]
  },
  "won": {
   "text": [
    "Oh, I won. Thanks for playing it through with me.",
    "Let's put the stones away. I'd like to look at our game."
   ],
   "goto": "reaction_offer"
  },
  "lost": {
   "text": [
    "You won. I want to look at our game before trying again.",
    "Thanks for sitting with me."
   ],
   "goto": "reaction_offer"
  },
  "reaction_offer": {},
  "newcomer_choice": {
   "choices": [
    {
     "text": "I'd like that.",
     "goto": "cup_company"
    },
    {
     "text": "I'm not ready for a tournament.",
     "goto": "no_hurry"
    },
    {
     "text": "Shall we practise?",
     "goto": "offer"
    },
    {
     "text": "I'll come back.",
     "exit": {
      "type": "end"
     }
    }
   ]
  },
  "cup_company": {
   "text": [
    "Good. We can start with a practice game, and take turns playing the others.",
    "Marguerite at the desk in the hall keeps the league register. She also takes Cup entries."
   ],
   "goto": "offer"
  },
  "no_hurry": {
   "text": [
    "Me neither, yet. You can just sit with me, or we can try a practice game.",
    "There's a place here even if you decide against the Cup."
   ],
   "goto": "offer"
  },
  "postcard": {
   "text": [
    "My old street. The shop on the corner has changed, but the postcard still has its green awning.",
    "I keep meaning to send it. Now I've brought it here instead."
   ]
  },
  "league_return": {
   "text": [
    "You've played everyone in the novice group. It feels less strange knowing all the faces now.",
    "I'm still planning on the Cup. Marguerite at the hall desk has the entry list."
   ],
   "actions": [
    [
     "set_flag",
     "noor_league_return_seen",
     true
    ]
   ],
   "goto": "offer"
  },
  "cup_return": {
   "text": [
    "You finished your first Cup. Was it strange sitting down with people from outside the club?",
    "Come and put your bag here. There's still room beside me."
   ],
   "actions": [
    [
     "set_flag",
     "noor_cup_return_seen",
     true
    ],
    [
     "set_flag",
     "noor_introduced",
     true
    ],
    [
     "set_flag",
     "noor_league_return_seen",
     true
    ]
   ],
   "goto": "offer"
  }
 }
}
