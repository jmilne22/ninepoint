# Godot's import cache and derived data. Everything else in this repo is source.
.godot/

# Local tooling, not the game: vendored third-party skills and their lock file.
.claude/
skills-lock.json

# Python bytecode from tools/. Regenerated on every run, so it dirtied
# `git status` after any generator and churned in every commit.
__pycache__/
*.pyc

# Downloaded by tools/setup_katago.sh from the pinned release manifest. They are
# verified local build inputs, not Git objects (the binary/models exceed GitHub's
# normal file-size limit).
/packaging/katago/bin/
/packaging/katago/lib/
/packaging/katago/models/
