; Ninepoint -- a Go RPG. See ARCHITECTURE.md.
config_version=5

[application]

config/name="Ninepoint"
config/description="A top-down RPG about learning to play Go."
run/main_scene="res://src/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/ui/icon.png"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
GameState="*res://src/autoload/game_state.gd"
SaveSystem="*res://src/autoload/save_system.gd"
SceneRouter="*res://src/autoload/scene_router.gd"
MatchBridge="*res://src/autoload/match_bridge.gd"
KataGoService="*res://src/autoload/katago_service.gd"
MatchReviewService="*res://src/autoload/match_review_service.gd"
PracticeSession="*res://src/practice/practice_session.gd"
Quests="*res://src/quest/quest_tracker.gd"
GameInput="*res://src/autoload/game_input.gd"
Autopilot="*res://src/autoload/autopilot.gd"
Audio="*res://src/autoload/audio.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1536
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
; Native-resolution text and vector panels can scale with the window.
window/stretch/scale_mode="fractional"

[gui]

theme/custom="res://src/ui/theme.tres"
theme/default_font_antialiasing=1
theme/default_font_subpixel_positioning=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false
environment/defaults/default_clear_color=Color(0.078, 0.071, 0.102, 1)

[physics]

2d/default_gravity=0.0
